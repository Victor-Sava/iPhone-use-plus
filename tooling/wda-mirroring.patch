 @implementation XCUIApplication (FBTouchAction)
 
+// --- 显示路由：与截图共用 currentDisplayId ---
++ (BOOL)fb_performScreenGestureFromPoint:(CGPoint)startPoint
+                               toPoint:(CGPoint)endPoint
+                         pressDuration:(NSTimeInterval)duration
+                                 error:(NSError **)error
+{
+  XCUIScreen *screen = [FBScreen currentScreenWithError:error];
+  if (nil == screen) {
+    return NO;
+  }
+  CGRect bounds = CGRectMake(0, 0, screen.bounds.size.width / screen.scale,
+                            screen.bounds.size.height / screen.scale);
+  if (!FBIsFinitePoint(startPoint) || !FBIsFinitePoint(endPoint)
+      || !CGRectContainsPoint(bounds, startPoint) || !CGRectContainsPoint(bounds, endPoint)
+      || !isfinite(duration) || duration < 0) {
+    return [[FBErrorBuilder.builder withDescription:@"Gesture coordinates or duration are invalid for the selected display"] buildError:error];
+  }
+  if (![XCSynthesizedEventRecord instancesRespondToSelector:@selector(initWithName:displayID:interfaceOrientation:)]) {
+    return [[FBErrorBuilder.builder withDescription:@"This XCTest runtime cannot route gestures to a selected display"] buildError:error];
+  }
+  [FBLogger logFmt:@"Selected display %@ gesture %@ -> %@", @(screen.displayID),
+    NSStringFromCGPoint(startPoint), NSStringFromCGPoint(endPoint)];
+  // 镜像截图为显示原生方向；不使用实体设备姿态或 SpringBoard 的方向。
+  XCSynthesizedEventRecord *event = [self fb_pressDragEventFromPoint:startPoint
+                                                     forDuration:duration
+                                                         toPoint:endPoint
+                                                 pointsPerSecond:FBPointsPerSecondForDragVelocity(XCUIGestureVelocityDefault)
+                                             thenHoldForDuration:0
+                                                       displayID:screen.displayID
+                                            interfaceOrientation:UIInterfaceOrientationPortrait];
+  return [FBXCTestDaemonsProxy synthesizeEventWithRecord:event error:error];
+}
