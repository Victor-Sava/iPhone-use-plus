   XCUIApplication *app = [self makeApplicationWithBundleId:bundleIdentifier];
+  // 已在镜像前台时只绑定上下文；重复 activate 会把设备切回实体屏幕。
+  if (nil != FBConfiguration.sharedInstance.currentDisplayId
+      && FBConfiguration.sharedInstance.currentDisplayId.longLongValue != [FBScreen displayID]
+      && app.state >= XCUIApplicationStateRunningForeground) {
+    self.lastActivatedApplication = app;
+    return app;
+  }
   [app activate];
+  self.lastActivatedApplication = app;
